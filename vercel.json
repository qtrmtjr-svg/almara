{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/admin/login", "methods": ["POST"], "dest": "/api/index" },
    { "src": "/api/(.*)", "dest": "/api/index" },
    { "src": "/admin/(.*)", "dest": "/api/index" },
    { "src": "/admin", "dest": "/api/index" }
  ]
}
