{
  "framework": null,
  "buildCommand": "",
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/admin/login", "destination": "/admin/login.html" },
    { "source": "/api/auth/:seg*", "destination": "/api/[...path]" },
    { "source": "/api/fb/:seg*", "destination": "/api/[...path]" },
    { "source": "/api/settings/:seg*", "destination": "/api/[...path]" },
    { "source": "/settings/:seg*.json", "destination": "/api/[...path]" }
  ]
}